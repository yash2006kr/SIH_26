# SkyGuard AI - Environment Configuration
# Copy this file to .env and configure your credentials.
# Do NOT commit your real .env file to Git.

# Google Gemini API Key (Get your key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Default: 8080)
PORT=8080

# Gemini Model Name (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Operator Authentication & Access Control Layer
AUTH_ENABLED=true
SKYGUARD_ADMIN_USER=operator
SKYGUARD_ADMIN_PASSWORD=SkyGuard@2026
SKYGUARD_AUTH_TOKEN=skyguard-sih2026-auth-token
SESSION_SECRET=change-this-to-a-secure-random-secret-key
